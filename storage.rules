rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function adminReader() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower() == 'kamalpadihar245@gmail.com'
          || request.auth.token.email.lower() == 'shrirashtriyajasmasenapariwar@gmail.com'
        );
    }

    match /application-photos/{fileName} {
      allow read: if adminReader();
      // Applicants may upload a new compressed JPEG; existing files cannot be overwritten.
      allow create: if request.resource != null
        && resource == null
        && request.resource.size <= 4718592
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
  }
}
